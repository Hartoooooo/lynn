# Supabase (Projekt-Einstellungen → API)
NEXT_PUBLIC_SUPABASE_URL=https://<projekt-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# KI-Suche (optional). Ohne Key bleibt der KI-Schalter deaktiviert.
ANTHROPIC_API_KEY=
# Optional: Modell und Tageslimit pro Nutzer
ANTHROPIC_MODEL=claude-opus-5-5
AI_DAILY_LIMIT=50
